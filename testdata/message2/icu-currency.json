{
  "$schema": "../../schemas/v0/tests.schema.json",
  "scenario": "Currency function",
  "description": "The built-in formatter and selector for currencies.",
  "defaultTestProperties": {
    "bidiIsolation": "none",
    "locale": "en-US"
  },
  "tests": [
    {
      "src": "{:currency}",
      "expErrors": [{ "type": "bad-operand" }]
    },
    {
      "src": "{foo :currency}",
      "expErrors": [{ "type": "bad-operand" }]
    },
    {
      "src": "{42 :currency}",
      "expErrors": [{ "type": "bad-operand" }]
    },
    {
      "src": ".local $n = {42 :number} {{{$n :currency}}}",
      "expErrors": [{ "type": "bad-operand" }]
    },
    {
      "src": "{42 :currency currency=EUR}",
      "exp": "€42.00"
    },
    {
      "src": ".local $n = {42 :number} {{{$n :currency currency=EUR}}}",
      "exp": "€42.00"
    },
    {
      "src": ".local $n = {42 :integer} {{{$n :currency currency=EUR}}}",
      "exp": "€42.00"
    },
    {
      "src": ".local $n = {42 :currency currency=EUR} {{{$n :currency}}}",
      "exp": "€42.00"
    },
    {
      "src": "{42 :currency currency=EUR fractionDigits=auto}",
      "exp": "€42.00"
    },
    {
      "src": "{42 :currency currency=EUR fractionDigits=2}",
      "exp": "€42.00"
    },
    {
      "src": "{$x :currency currency=EUR}",
      "params": [{ "name": "x", "value": 41 }],
      "exp": "€41.00"
    },
    {
      "src": ".local $n = {42 :currency currency=EUR} .match $n * {{other}}",
      "exp": "other",
      "expErrors": [{ "type": "bad-selector" }]
    },
    {
      "src": "{42 :currency currency=no}",
      "expErrors": [{ "type": "bad-option" }],
      "description": "The CurrencyUnit constructor only rejects strings whose length is < 3"
    },
    {
      "src": "{-42 :currency currency=EUR currencySign=accounting}",
      "exp": "(€42.00)"
    },
    {
      "src": "{-42 :currency currency=EUR}",
      "exp": "-€42.00"
    },
    {
      "src": "{-42 :currency currency=EUR currencyDisplay=code}",
      "exp": "-EUR 42.00"
    },
    {
      "src": "{-42 :currency currency=CAD currencyDisplay=symbol}",
      "exp": "-CA$42.00"
    },
    {
      "src": "{-42 :currency currency=CAD currencyDisplay=narrowSymbol}",
      "exp": "-$42.00"
    },
    {
      "src": "{42 :currency currency=EUR currencyDisplay=name}",
      "exp": "42.00 euros"
    },
    {
      "src": "{42 :currency currency=EUR currencyDisplay=never}",
      "exp": "42.00"
    },
    {
      "src": "{42 :currency currency=EUR useGrouping=auto}",
      "exp": "€42.00"
    },
    {
      "src": "{42345 :currency currency=EUR useGrouping=always}",
      "exp": "€42,345.00"
    },
    {
      "src": "{42345 :currency currency=EUR useGrouping=auto}",
      "exp": "€42,345.00"
    },
    {
      "src": "{4234 :currency currency=EUR useGrouping=min2}",
      "exp": "€4234.00"
    },
    {
      "src": "{42341 :currency currency=EUR useGrouping=min2}",
      "exp": "€42,341.00"
    },
    {
      "src": "{4234 :currency currency=EUR useGrouping=never}",
      "exp": "€4234.00"
    },
    {
      "src": "{42 :currency currency=EUR minimumIntegerDigits=4}",
      "exp": "€0,042.00"
    },
    {
      "src": "{42 :currency currency=EUR fractionDigits=4}",
      "exp": "€42.0000"
    },
    {
      "src": "{42 :currency currency=EUR minimumSignificantDigits=5}",
      "exp": "€42.000"
    },
    {
      "src": "{4212 :currency currency=EUR maximumSignificantDigits=3}",
      "exp": "€4,210"
    },
    {
      "src": "{42 :currency currency=EUR trailingZeroDisplay=auto}",
      "exp": "€42.00"
    },
    {
      "src": "{42 :currency currency=EUR trailingZeroDisplay=stripIfInteger}",
      "exp": "€42"
    },
    {
      "src": "{42.34 :currency currency=EUR roundingPriority=morePrecision minimumSignificantDigits=1 maximumSignificantDigits=3 fractionDigits=4}",
      "exp": "€42.3400"
    },
    {
      "src": "{42.34 :currency currency=EUR roundingPriority=lessPrecision minimumSignificantDigits=1 maximumSignificantDigits=3 fractionDigits=4}",
      "exp": "€42.3"
    },
    {
      "src": "{42.3456 :currency currency=EUR fractionDigits=2 roundingIncrement=1}",
      "exp": "€42"
    },
    {
      "src": "{47.3456 :currency currency=EUR fractionDigits=2 roundingIncrement=5}",
      "exp": "€45"
    },
    {
      "src": "{42.3456 :currency currency=EUR fractionDigits=2 roundingIncrement=10}",
      "exp": "€40"
    }
  ]
}
